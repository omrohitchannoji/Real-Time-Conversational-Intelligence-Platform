# MongoDB Atlas Cloud Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/context-modeling?retryWrites=true&w=majority
MONGO_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/context-modeling?retryWrites=true&w=majority
DATABASE_NAME=context-modeling
# Neo4j AuraDB Cloud Connection Settings
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_aura_password
NEO4J_DATABASE=neo4j
# AI Engine Authentication
GROQ_API_KEY=gsk_your_groq_api_key_here
HF_TOKEN=hf_your_huggingface_token_here
# Kafka Streaming Configuration
KAFKA_BOOTSTRAP_SERVER=localhost:9092
KAFKA_TOPIC=reddit_messages
